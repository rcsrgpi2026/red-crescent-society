# ------------------------------------------------------------------
# Supabase — create a free project at https://supabase.com
# Copy this file to `.env.local` and fill in the values.
# ------------------------------------------------------------------

# Project URL: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose this to the client.
# Used for audit logging & smart notifications. Get it from: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed site (used for sitemap, OG and QR codes).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------
# Web Push (VAPID) — Smart Notifications
# Generate a pair using: npx web-push generate-vapid-keys
# ------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@rcy-rgpi.org

# ------------------------------------------------------------------
# Gmail SMTP (Recommended for 100% Inbox Delivery)
# 1. Enable 2-Step Verification on your Gmail account
# 2. Visit https://myaccount.google.com/apppasswords
# 3. Create an App password (e.g. name: "RCY Portal")
# 4. Paste the 16-character password into SMTP_PASS
# ------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=redcrescentyouthrgpi@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM_NAME="Red Crescent Youth"

# ------------------------------------------------------------------
# Resend — Alternative Transactional Email Delivery (Optional fallback)
# ------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Red Crescent Youth <redcrescentyouthrgpi@gmail.com>

# ------------------------------------------------------------------
# Cloudinary (Free Image Storage & CDN — No Credit Card Needed)
# Get credentials from your Cloudinary Dashboard: https://cloudinary.com
# ------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
