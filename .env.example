# ------------------------------------------------------------------
# Supabase — create a free project at https://supabase.com
# Copy this file to `.env.local` and fill in the values.
# ------------------------------------------------------------------

# Project URL: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose this to the client.
# Used for audit logging. Get it from: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the deployed site (used for sitemap, OG and QR codes).
NEXT_PUBLIC_APP_URL=http://localhost:3000
